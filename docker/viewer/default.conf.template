# Rate limiting zone (issue #4: missing rate limiting)
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

# issue #94: an args-free access-log format. The default combined format
# logs $request (the raw request LINE, query string included) -- any
# credential or PHI ever passed in a query string was therefore copied
# into access.log verbatim (audit-confirmed with a live session token,
# issues #63/#94). Since grading-api now takes its token as a header and
# no /api/ endpoint needs query parameters, the API's log line records
# only the path. Orthanc's proxy server block keeps default logging:
# its GETs carry legitimate non-secret query parameters that are useful
# in logs and nothing credential-like (Basic Auth is a HEADER, and nginx
# never logs headers).
log_format api_no_args '$remote_addr - $remote_user [$time_local] '
                       '"$request_method $uri $server_protocol" $status '
                       '$request_length "$http_referer"';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Watermarked wrapper page - this is what the Kasm workspace opens in kiosk mode.
    location = / {
        index watermark.html;
    }

    # `index` above internally redirects "/" to this path -- add_header on
    # `location = /` alone does NOT apply to that redirected request (classic
    # nginx gotcha: it only applies to responses generated directly by that
    # same location block), so it has to be set here, on the resolved path,
    # to actually take effect. no-store: this page changes often during
    # active development, and each Kasm session should always get the
    # current version, never a browser-cached one from an earlier build.
    location = /watermark.html {
        add_header Cache-Control "no-store" always;
    }

    # Issue #5: panel-only page for the Weasis flow (no iframe, Weasis shows
    # the images in its own window instead). Same no-store reasoning as
    # /watermark.html above -- changes often during active development.
    location = /grading-panel.html {
        add_header Cache-Control "no-store" always;
    }

    # Orthanc is deliberately NOT reverse-proxied under a subpath here: its
    # Explorer2/Stone-Viewer front ends assume they're served from their own
    # origin's root, and a /orthanc/ prefix breaks their asset paths. The
    # watermark wrapper iframes Orthanc's own origin directly instead (see
    # watermark.html's `orthanc_url` param and docker-compose.yml's comment
    # on the 8042 port).

    # grading-api is a plain JSON API (no relative-asset-path problem like
    # Orthanc's SPA has), so a subpath proxy is fine here -- keeps
    # watermark.html's fetch() calls same-origin, no CORS needed.
    location /api/ {
        # Rate limiting (issue #4: missing rate limiting)
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;

        # issue #93/#94: reject oversized bodies at the edge before they
        # reach (and get logged-by) the app. 64k, not the suggested 32k:
        # /submit legitimately carries a max_length=10_000-char free-text
        # answer, which is ~30 KB of ASCII but up to ~40 KB of 4-byte
        # UTF-8 once JSON-escaped -- 32k would 413 real submissions.
        # Everything above 64k is noise or an attack, and neither gets
        # proxied, answered verbosely, or logged in body form.
        client_max_body_size 64k;

        # issue #94, belt-and-braces: NO /api/ request may carry a query
        # string at all. Empirically (test-log-leak.sh against the real
        # image): `set $args ''` keeps the query out of the UPSTREAM URL
        # and the args-free access format keeps it out of access.log --
        # but nginx's error.log embeds the client's raw request line in
        # its "request:" field for every upstream failure, and that
        # field is not formatable. So a query-carrying request is
        # refused here, before proxying: it generates no upstream
        # attempt, hence no error line, and the access line it does
        # produce uses the args-free format. No legitimate request is
        # affected -- /api/case and /api/results take the token as a
        # header and nothing under /api/ reads query parameters; if
        # that ever changes, this block and `set $args` must change
        # with it.
        if ($args) {
            return 422;
        }
        set $args '';

        # issue #51: /dev/stdout, not /var/log/nginx/access.log -- the
        # nginx master now runs as uid 101 on a read_only root filesystem
        # (see docker/viewer/Dockerfile); the line still lands in
        # `docker logs`, which is where scripts/test-log-leak.sh reads it.
        access_log /dev/stdout api_no_args;

        proxy_pass http://grading-api:8000/;
        proxy_set_header Host $host;
    }
}

server {
    # Auth-transparent proxy to Orthanc, at its own origin's root (so asset
    # paths still work) but with Basic Auth injected server-side - an iframe
    # can't answer a login challenge, so the un-proxied Orthanc origin just
    # renders blank. Orthanc's own auth stays ON (defense in depth); this is
    # the only thing allowed to see these credentials.
    # ORTHANC_AUTH_B64 is computed at container start by
    # 15-compute-orthanc-auth.envsh from ORTHANC_USER/ORTHANC_PASSWORD, then
    # substituted into this file by the base image's own envsubst-on-templates
    # entrypoint step - nothing real is hardcoded in this committed file.
    listen 8043;
    server_name _;

    # issue #64: this proxy used to forward every method to every path --
    # anyone who could reach it (any container on kasm_default_network, not
    # just `viewer`) got Orthanc's full authenticated REST API, including
    # write/delete, not just the read-only browsing this platform actually
    # needs. Shared by every location below (nginx inherits proxy_* at
    # server level unless a location overrides them).
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Authorization "Basic ${ORTHANC_AUTH_B64}";
    proxy_http_version 1.1;
    proxy_buffering off;

    # Confirmed via a real Playwright-driven browse-and-open flow (not
    # assumed, not the narrower "/dicom-web/ only" fix originally proposed
    # -- that would have broken Explorer2 outright: it barely touches
    # /dicom-web/ at all, and does its own browsing via Orthanc's native
    # REST API across many paths -- /ui/*, /system, /peers, /modalities,
    # /statistics, /studies/.../series, /instances/.../tags, /tools/labels,
    # etc.) that /tools/find is the *only* non-GET call ordinary read-only
    # browsing makes: Orthanc's own "search/query" endpoint, POST-based by
    # Orthanc's REST API design (it takes a JSON query body) despite being
    # a pure read, used for the study/series list and the filtered-studies
    # view's own StudyInstanceUID lookup.
    # SPIKE #195: scoped read access. /s/<key>/dicom-web/... is authorised per request by
    # grading-api (auth_request) and then forwarded WITHOUT the /s/<key> prefix.
    location ~ "^/s/[0-9a-f]{64}/dicom-web/" {
        limit_except GET HEAD {
            deny all;
        }
        auth_request /_authz;
        rewrite "^/s/[0-9a-f]{64}(/.*)$" $1 break;
        proxy_pass http://orthanc:8042;
    }
    location = /_authz {
        internal;
        proxy_pass http://grading-api:8000/orthanc-authz;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Authorization "";
    }

    location = /tools/find {
        limit_except POST {
            deny all;
        }
        proxy_pass http://orthanc:8042/tools/find;
    }

    location / {
        # Default-deny anything else non-GET/HEAD. This -- not a path
        # allowlist -- is what actually closes the real gap (write/delete
        # reachable at all): every GET-based endpoint Explorer2 or Weasis's
        # DICOMweb queries use keeps working, including ones not explicitly
        # enumerated here or added in a future Orthanc/Explorer2 version,
        # while POST/PUT/DELETE against anything (upload, delete, execute-
        # script, modality/peer store, settings) is rejected outright,
        # regardless of path.
        limit_except GET HEAD {
            deny all;
        }
        proxy_pass http://orthanc:8042/;
    }
}
