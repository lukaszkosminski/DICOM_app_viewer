# Copy this file to .env (already gitignored) and fill in real values.
# Never commit .env itself.
#
# Generate one with: openssl rand -hex 16
ORTHANC_PASSWORD=

# Shared secret between grading-api and scripts/create-session.py -- the
# only thing allowed to mint a grading-api session token (POST /session).
# Without this, any client could mint its own token for any student_id and
# recreate the exact authorization gap this token system exists to close.
# Minimum 32 characters -- grading-api refuses to start below that (issue
# #97; BREAKING for deployments that used a shorter key), and leading/
# trailing whitespace (a classic .env artifact) is rejected, not stripped.
# Generate one with: openssl rand -hex 32
GRADING_COORDINATOR_KEY=

# Only needed for the Guacamole PoC (docker-compose.guacamole.yml) --
# password for Guacamole's own required JDBC auth database (Postgres),
# unrelated to grading-api's own SQLite database.
# Generate one with: openssl rand -hex 16
GUACAMOLE_DB_PASSWORD=

# Optional. Path INSIDE the grading-api container to a JSON file with the real cases
# (answer key, reference reports, study UIDs); built by scripts/build-cases-file.py
# into the git-ignored ./local directory, e.g. /local/cases.json. Empty = the
# placeholder cases. Only read when the cases table is still empty (fresh volume).
GRADING_CASES_FILE=

# ---------------------------------------------------------------------------
# Optional user configuration -- the full inventory with defaults, classes and
# validation rules lives in docs/CONFIG.md (issue #91). Uncomment to override.
# ---------------------------------------------------------------------------

# Remote-host compose publish address for :8042/:8080/:8043 (default 0.0.0.0).
# On shared hosts prefer 127.0.0.1 until the #103/#146 topology decision lands
# (0.0.0.0 currently publishes Orthanc DICOMWeb to the network).
#BIND_ADDR=127.0.0.1

# Session-token lifetime in seconds (default 28800 = 8 h; integer, 1..604800).
# Longer TTLs keep links alive across the 24-48 h exam windows -- owner
# decision tracked in #122; shorter ones expire mid-session by design.
#GRADING_TOKEN_TTL_SECONDS=28800

# SQLite path INSIDE the grading-api container (default /data/grading.db).
#GRADING_DB_PATH=/data/grading.db

# Extra CA bundle (PEM) for grading-api/Kasm endpoints served with private
# TLS (verification is ON by default, issue #103): export TLS_CA_BUNDLE=...
#TLS_CA_BUNDLE=/etc/kasm/ca.pem

# create-session.py operator configuration (Kasm flow). Keys are secrets:
# keep them in the operator's environment, never in logs or commits.
#GRADING_API_URL=http://localhost:8080
#KASM_SERVER=https://kasm.example.internal
#KASM_API_KEY=
#KASM_API_KEY_SECRET=
#KASM_IMAGE_ID=

# Guacamole PoC operator configuration (provision/teardown scripts).
# The admin password default is the weak stock guacadmin -- PoC seam only,
# set a real value for anything reachable beyond localhost.
#GUACAMOLE_URL=http://localhost:8090/guacamole/
#GUACAMOLE_ADMIN_USERNAME=guacadmin
#GUACAMOLE_ADMIN_PASSWORD=
# Guacamole user-account expiry in hours (day-grained backstop; default 48)
#GUACAMOLE_USER_VALID_HOURS=48
